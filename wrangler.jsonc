{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witnessrecord",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    // Lets worker.js hand non-redirected hosts to the static files.
    "binding": "ASSETS",
    // The worker has to see every request to check the host first.
    "run_worker_first": true,
    // "none" turned out to also disable the implicit "/" -> "/index.html"
    // mapping, taking the homepage down. Back to the platform default, which
    // costs inner pages one redirect hop but keeps "/" working.
    "html_handling": "auto-trailing-slash",
    // Serves our own styled 404.html (with a real 404 status) instead of the
    // platform's default not-found response.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
