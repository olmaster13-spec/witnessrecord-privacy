{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witnessrecord",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    // Every internal link, the sitemap, llms.txt and every canonical tag
    // point at the literal .html path. Leaving Cloudflare's default clean-URL
    // redirect on would send every one of those through an extra 307 hop.
    "html_handling": "none",
    // Serves our own styled 404.html (with a real 404 status) instead of the
    // platform's default not-found response.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
