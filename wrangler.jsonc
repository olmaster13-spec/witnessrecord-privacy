{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witnessrecord",
  "compatibility_date": "2026-08-28",
  // Only for /api/usage, the app's opt-in anonymous counts; the rest of the
  // site is served from the assets as before.
  "main": "_worker/index.js",
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "witness_usage" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // "none" turned out to also disable the implicit "/" -> "/index.html"
    // mapping, taking the homepage down. Back to the platform default, which
    // costs inner pages one redirect hop but keeps "/" working.
    "html_handling": "auto-trailing-slash",
    // Serves our own styled 404.html (with a real 404 status) instead of the
    // platform's default not-found response.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
