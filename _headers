# Cloudflare Pages headers.
# Read by Pages at deploy time; the file itself is never served.

/*
  # Readers of this site are often on networks they do not control, and the
  # outbound links go to legal-aid and civil-liberties organisations. Sending
  # no referrer at all keeps that browsing out of third-party logs.
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-addressed enough in practice: these files change only on redeploy,
# and a stale copy of a screenshot is harmless.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=3600, must-revalidate

# Machine-readable descriptions, kept fresh for crawlers.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
